program tes_div_slash_error
kamus
    a : integer
    b : real
    hasil_real : real
algoritma
    a <- 7
    b <- 7.5

    // 2. riil div int -> HARUS ERROR
    hasil_real <- b div 2

    // 3. int div riil -> HARUS ERROR
    hasil_real <- a div 2.5

    // 4. riil div riil -> HARUS ERROR
    hasil_real <- b div 2.5

    tulis(hasil_real)
endprogram
