program count
dictionary
    i, n, x : integer  // deklarasi variabel
    y, yt, y2 : real
    const DELTA = 0.00000005
algorithm
    read n
    for x = 1 to n do
        y = n
        y2 = n
        repeat
            y = (y + x/(y*y))/2
            yt = y2
            y2 = (yt + x/yt) / 2
        until (y2-yt < DELTA) and (yt-y2 < DELTA)
        print(x, y, y2*y2)
    endfor
endprogram
